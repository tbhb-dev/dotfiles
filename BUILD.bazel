repo_files(exclude = ["home/**"])

gitleaks_test(
    name = "gitleaks_test",
    srcs = [":repo_files"],
    config = ".gitleaks.toml",
)

gitleaks_history(
    name = "gitleaks_history",
    config = ".gitleaks.toml",
)

# The repository's shape. Only these top-level directories may exist; add a
# new one here in the change that first uses it.
repo_layout_test(
    name = "repo_layout_test",
    srcs = [":repo_files"],
    top_level_dirs = [
        ".claude",
        ".devcontainer",
        ".github",
        ".vale",
        "LICENSES",
        "home",
        "script",
    ],
)

buildifier_test(
    name = "buildifier_test",
    exclude_patterns = [
        "./.git/*",
        "./.mise/*",
        "./bazel-*",
        "./.bazel-*",
        "./.worktrees/*",
        "./tmp/*",
    ],
    lint_mode = "warn",
    lint_warnings = ["all"],
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

