# The packages .vale.ini lists, pinned in MODULE.bazel, in the config's
# order. `bazel run //:vale_sync` writes them into .vale/ for editors.
VALE_PACKAGES = {
    "Google": "@vale_google//file",
    "ai-tells": "@vale_ai_tells//file",
    "ai-tells-experimental": "@vale_ai_tells_experimental//file",
    "proselint": "@vale_proselint//file",
    "write-good": "@vale_write_good//file",
}

vale_test(
    name = "vale_test",
    srcs = [":repo_files"],
    config = ".vale.ini",
    packages = VALE_PACKAGES,
)

vale_sync(
    name = "vale_sync",
    config = ".vale.ini",
    packages = VALE_PACKAGES,
)

# `bazel run //:bazel_env` puts shims for the Bazel-pinned tools in
# .bazel_env/bin, which mise adds to PATH. Git hooks call them directly, so
# a commit never waits on the Bazel server.
bazel_env(
    name = "bazel_env",
    tools = {
        "actionlint": "@tbhb_rules_actionlint//:actionlint",
        "buildifier": "@buildifier_prebuilt//:buildifier",
        "cog": "@tbhb_rules_cog//:cog",
        "editorconfig-checker": "@tbhb_rules_editorconfig_checker//:editorconfig-checker",
        "gitleaks": "@tbhb_rules_gitleaks//:gitleaks",
        "rumdl": "@tbhb_rules_rumdl//:rumdl",
        "ryl": "@tbhb_rules_ryl//:ryl",
        "shellcheck": "@tbhb_rules_shellcheck//:shellcheck",
        "shfmt": "@tbhb_rules_shfmt//:shfmt",
        "tombi": "@tbhb_rules_tombi//:tombi",
        "vale": "@tbhb_rules_vale//:vale",
        "zizmor": "@tbhb_rules_zizmor//:zizmor",
    },
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

alias(
    name = "chezmoi",
    actual = select({
        ":linux_arm64": "@chezmoi_linux_arm64//:chezmoi",
        ":macos_arm64": "@chezmoi_macos_arm64//:chezmoi",
        "//conditions:default": "@chezmoi_linux_x86_64//:chezmoi",
    }),
)

# Renders every chezmoi template under fixed darwin and linux data with the
# pinned chezmoi, then checks the output. No network, no secret store.
sh_test(
    name = "render_test",
    srcs = ["script/test-render"],
    data = [
        ":chezmoi",
        "//:home_files",
    ],
    env = {"CHEZMOI_BIN": "$(rootpath :chezmoi)"},
)

# Checks the deny-list merge in modify_settings.json.tmpl against sample live
# files, with the pinned chezmoi. No network, no secret store.
sh_test(
    name = "modify_settings_test",
    srcs = ["script/test-modify-settings"],
    data = [
        ":chezmoi",
        "//:home_files",
    ],
    env = {"CHEZMOI_BIN": "$(rootpath :chezmoi)"},
)

filegroup(
    name = "home_files",
    srcs = glob(
        ["home/**"],
        allow_empty = False,
        exclude_directories = 0,
    ),
)
