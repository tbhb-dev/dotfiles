{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $isDevcontainer := or (env "REMOTE_CONTAINERS") (env "CODESPACES") -}}
{{- $brewPrefix := "" -}}
{{- if $isDarwin -}}
{{-   $brewPrefix = "/opt/homebrew" -}}
{{- else if $isLinux -}}
{{-   $brewPrefix = "/home/linuxbrew/.linuxbrew" -}}
{{- end -}}
bindkey -e

# Docker CLI completions
if [ -d "$HOME/.docker/completions" ]; then
  fpath=($HOME/.docker/completions $fpath)
fi

# Zsh completion system
autoload -Uz compinit && compinit

# Tool integrations
command -v fzf &>/dev/null && source <(fzf --zsh)
{{ if $isDarwin -}}
command -v op &>/dev/null && eval "$(op completion zsh)" && compdef _op op
{{ end -}}

# Use different tmux sockets for different terminals
case "$TERM_PROGRAM" in
{{ if $isDarwin }}  ghostty)
    export TMUX_TMPDIR="${TMPDIR:-/tmp}/tmux-ghostty"
    mkdir -p "$TMUX_TMPDIR"
    ;;
  zed)
    export TMUX_TMPDIR="${TMPDIR:-/tmp}/tmux-zed"
    mkdir -p "$TMUX_TMPDIR"
    ;;
{{ end }}  vscode)
    export TMUX_TMPDIR="${TMPDIR:-/tmp}/tmux-vscode"
    mkdir -p "$TMUX_TMPDIR"
    ;;
esac

# Only load line-editor plugins / prompt in a real terminal (not VSCode's
# env-resolution shell or other headless `zsh -i` invocations).
if [[ -t 0 && -t 1 && -z "$VSCODE_RESOLVING_ENVIRONMENT" ]]; then
  _zle_ok=1
fi

# zsh plugins
if (( _zle_ok )); then
{{ if ne $brewPrefix "" -}}
{{ "  " }}if [ -f "{{ $brewPrefix }}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
    source "{{ $brewPrefix }}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  elif [ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  fi
{{ else -}}
{{ "  " }}[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
{{ end -}}
fi
alias bx='bundle exec'
alias g='git'
alias ga='git add'
alias gc='git commit'
alias gco='git checkout'
alias gp='git push'
alias gs='git status'
alias nv='nvim'
alias reload='source ~/.zshrc'
alias mkpasswd='docker run --rm -ti alpine:latest mkpasswd -m sha512'
{{ if $isDarwin -}}
alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
{{ end -}}

eval "$(mise activate zsh)"
(( _zle_ok )) && eval "$(starship init zsh)"

{{ if $isDarwin -}}
# agent-safehouse
SAFEHOUSE_APPEND_PROFILE="$HOME/.config/agent-safehouse/local-overrides.sb"

safe() { safehouse --add-dirs-ro=~/Code --enable=browser-native-messaging --append-profile="$SAFEHOUSE_APPEND_PROFILE" "$@"; }
safe-claude() { safe claude --dangerously-skip-permissions "$@"; }
safe-claude-workspace() { safe --add-dirs=$PWD/.. -- claude --dangerously-skip-permissions "$@"; }
safe-codex() { safe codex --dangerously-bypass-approvals-and-sandbox "$@"; }
safe-codex-workspace() { safe --add-dirs=$PWD/.. -- codex --dangerously-bypass-approvals-and-sandbox "$@"; }
{{ end }}
# Claude Code with the awrel channel. Development channels are opted into per
# session on the command line; settings.json can't enable them. So when this
# repo's .mcp.json defines an awrel server, add the flag. Subcommands (claude
# mcp, claude update, ...) and -p/--print runs are passed through untouched:
# non-interactive sessions ignore the flag anyway.
claude() {
  local root
  root=$(command git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
  if [[ -f $root/.mcp.json ]] && command grep -q '"awrel"' "$root/.mcp.json" \
    && { (( $# == 0 )) || [[ $1 == -* ]]; } \
    && (( ! ${@[(I)-p]} && ! ${@[(I)--print]} && ! ${@[(I)--dangerously-load-development-channels]} )); then
    command claude --dangerously-load-development-channels server:awrel "$@"
  else
    command claude "$@"
  fi
}

# Clone a GitHub repo into ~/Code/github.com/<org>/<repo>, or update it if already cloned
ghrc() {
  if [ -z "$1" ]; then
    echo "usage: ghrc <org>/<repo>" >&2
    return 1
  fi
  local dir="{{ .chezmoi.homeDir }}/Code/github.com/$1"
  if [ -d "$dir/.git" ]; then
    git -C "$dir" up
  else
    gh repo clone "$1" "$dir"
  fi
}

# Google Cloud SDK
if [ -f '{{ .chezmoi.homeDir }}/google-cloud-sdk/completion.zsh.inc' ]; then . '{{ .chezmoi.homeDir }}/google-cloud-sdk/completion.zsh.inc'; fi

# kubeswitch
if command -v switcher &>/dev/null; then
  source <(switcher init zsh)
  alias ks=switch
  source <(switch completion zsh)
fi


# Added by Antigravity CLI installer
export PATH="{{ .chezmoi.homeDir }}/.local/bin:$PATH"

# zsh-syntax-highlighting must be sourced LAST: it wraps every ZLE widget
# defined before it, and widgets defined after it cause recursive re-wrapping.
if (( _zle_ok )); then
{{ if ne $brewPrefix "" -}}
{{ "  " }}if [ -f "{{ $brewPrefix }}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
    source "{{ $brewPrefix }}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  elif [ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
  fi
{{ else -}}
{{ "  " }}[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{ end -}}
fi
unset _zle_ok
