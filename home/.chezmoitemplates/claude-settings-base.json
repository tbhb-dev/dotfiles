      "Bash(gh pr reopen:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr lock:*)",
      "Bash(gh pr unlock:*)",
      "Bash(gh pr update-branch:*)",
      "Bash(gh pr revert:*)",
      "Bash(gh -R* pr close*)",
      "Bash(gh -R* pr reopen*)",
      "Bash(gh pr -R* close*)",
      "Bash(gh pr -R* reopen*)",
      "Bash(gh --repo* pr close*)",
      "Bash(gh --repo* pr reopen*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh issue transfer:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(~/.1password/*)",
      "Read(~/.acme.sh/account.conf)",
      "Read(**/.ansible/*)",
      "Read(~/.aws/credentials)",
      "Read(~/.boto)",
      "Read(~/.chef/credentials)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.config/gcloud/*)",
      "Read(~/.config/github-copilot/apps.json)",
      "Read(~/.dbt/profiles.yml)",
      "Read(~/.docker/.token_seed)",
      "Read(~/.docker/config.json)",
      "Read(~/.gemini/oauth_creds.json)",
      "Read(~/.gnupg/*)",
      "Read(~/.gsutil/credstore2)",
      "Read(~/.kube/config*)",
      "Read(~/.netrc)",
      "Read(~/.ssh/*)",
      "Read(~/.terraform.d/*)",
      "Read(~/.zsh_history)"
