      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(npm --version:*)",
      "Bash(pwd:*)",
      "Bash(rg:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(uv --version:*)",
      "Bash(uv add:*)",
      "Bash(uv cache dir:*)",
      "Bash(uv init:*)",
      "Bash(uv lock --check:*)",
      "Bash(uv lock:*)",
      "Bash(uv pip check:*)",
      "Bash(uv pip compile:*)",
      "Bash(uv pip install:*)",
      "Bash(uv pip list:*)",
      "Bash(uv pip show:*)",
      "Bash(uv pip sync:*)",
      "Bash(uv pip tree:*)",
      "Bash(uv pip uninstall:*)",
      "Bash(uv python find:*)",
      "Bash(uv python install:*)",
      "Bash(uv python list:*)",
      "Bash(uv python pin:*)",
      "Bash(uv remove:*)",
      "Bash(uv sync:*)",
      "Bash(uv tool list:*)",
      "Bash(uv tree:*)",
      "Bash(uv venv:*)",
      "Bash(uv version:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Read(~/.config/git/*)",
      "Read(~/.gitconfig)",
      "Read(~/.gitignore)",
      "Read(~/.node-version)",
      "Read(~/.nvmrc)",
      "Read(~/.tool-versions)",
      "Read(~/.zshrc)",
      "WebFetch(domain:*.anthropic.com)",
      "WebFetch(domain:*.claude.com)",
      "WebFetch(domain:anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:vale.sh)"
