{{- $isDevcontainer := or (env "REMOTE_CONTAINERS") (env "CODESPACES") -}}
{{- $brewPrefix := "/home/linuxbrew/.linuxbrew" -}}
{{- if and (eq .chezmoi.os "linux") (not $isDevcontainer) -}}
# Runs ~/.local/bin/tbhb-dotfiles-drift; tbhb-dotfiles-drift.timer starts it.
# Its one output line goes to the journal, and drift marks the run failed.
[Unit]
Description=Report drift of the chezmoi source and home from origin/main

[Service]
Type=oneshot
Environment="PATH={{ $brewPrefix }}/bin:{{ .chezmoi.homeDir }}/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart="{{ .chezmoi.homeDir }}/.local/bin/tbhb-dotfiles-drift"
TimeoutStartSec=10min
# Log shipping keys journal lines on the syslog identifier.
SyslogIdentifier=tbhb-dotfiles-drift
{{- end }}
