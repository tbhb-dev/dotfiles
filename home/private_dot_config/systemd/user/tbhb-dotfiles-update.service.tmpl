{{- $brewPrefix := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $brewPrefix = "/opt/homebrew" -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $brewPrefix = "/home/linuxbrew/.linuxbrew" -}}
{{- end -}}
{{- $isDevcontainer := or (env "REMOTE_CONTAINERS") (env "CODESPACES") -}}
{{- if and (eq .chezmoi.os "linux") (not $isDevcontainer) -}}
# Runs ~/.local/bin/tbhb-dotfiles-update; tbhb-dotfiles-update.timer starts it.
[Unit]
Description=Fast-forward the chezmoi source to origin/main and apply it

[Service]
Type=oneshot
Environment=PATH={{ $brewPrefix }}/bin:{{ .chezmoi.homeDir }}/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart={{ .chezmoi.homeDir }}/.local/bin/tbhb-dotfiles-update
{{- end }}
