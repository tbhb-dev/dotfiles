{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $isDevcontainer := or (env "REMOTE_CONTAINERS") (env "CODESPACES") -}}
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",*:RGB"

set-option -g prefix C-q
bind-key C-q last-window
bind-key q send-prefix

setw -g aggressive-resize no

# set -g mouse on

# Pane border styling (Monokai Pro)
set -g pane-border-style 'fg=#403e41'
set -g pane-active-border-style 'fg=#a9dc76,bold'
set -g pane-border-lines heavy

set -g base-index 1
setw -g pane-base-index 1
unbind 0
bind 0 kill-pane

setw -g mode-keys vi
bind ` copy-mode
unbind [
unbind p
bind p paste-buffer
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi Escape send-keys -X cancel

unbind %
unbind c
bind c new-window -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind | split-window -h -c "#{pane_current_path}"

bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'

# Monokai Pro pills in native status formats; cpu and mem come from small scripts.
set -g status-style 'fg=#fcfcfa,bg=default'
set -g message-style 'fg=#fcfcfa,bg=default'
set -g status-interval 1
set -g status-justify centre
set -g status-left-length 60
set -g status-right-length 90
set -g status-left '#[fg=#78dce8,bg=default]#[fg=#2d2a2e,bg=#78dce8] #h #[fg=#78dce8,bg=#ab9df2]#[fg=#2d2a2e,bg=#ab9df2] #S #[fg=#ab9df2,bg=default]'
set -g status-right '#[fg=#403e41,bg=default]#[fg=#fc9867,bg=#403e41]#({{ .chezmoi.homeDir }}/.config/tmux-status/cpu.sh)#({{ .chezmoi.homeDir }}/.config/tmux-status/mem.sh)#[fg=#959394]%F %H:%M#[fg=#403e41,bg=default]'
set -g window-status-separator ' '
set -g window-status-current-format '#[fg=#a9dc76,bg=default]#[fg=#2d2a2e,bg=#a9dc76,bold]#I#[fg=#a9dc76,bg=#8ab866,nobold]#[fg=#2d2a2e,bg=#8ab866] #W#[fg=#8ab866,bg=default]'
set -g window-status-format '#[fg=#403e41,bg=default]#[fg=#959394,bg=#403e41]#I#[fg=#403e41,bg=#4a474b]#[fg=#959394,bg=#4a474b] #W#[fg=#4a474b,bg=default]'

if-shell '[ -f {{ .chezmoi.homeDir }}/.tmux/plugins/tpm/tpm ]' \
  'run "{{ .chezmoi.homeDir }}/.tmux/plugins/tpm/tpm"'

# Add empty line above the status bar for padding
set -g status 2
set -gF status-format[1] '#{status-format[0]}'
set -g status-format[0] ''
