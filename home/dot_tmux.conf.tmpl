{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $isDevcontainer := or (env "REMOTE_CONTAINERS") (env "CODESPACES") -}}
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",*:RGB"

# A server started from a terminal login shell inherits the 1Password marker and
# socket. Panes run login shells that set both again for the operator; anything else
# started from the server (run-shell, a command passed to new-window) gets neither.
set-environment -gu TBHB_OP_AGENT
# A server a harness started carries its CLAUDECODE or CODEX_HOME. Drop them so the
# operator's panes are not read as agent shells. claude and codex set their own for
# their children.
set-environment -gu CLAUDECODE
set-environment -gu CODEX_HOME
if-shell 'case "$SSH_AUTH_SOCK" in *1password*) exit 0;; esac; exit 1' 'set-environment -gu SSH_AUTH_SOCK'
# A new session and every attach copy the client's SSH_AUTH_SOCK into the session
# environment, so drop a 1Password socket there too. A forwarded agent stays.
set-hook -g after-new-session 'run-shell "case \"$(tmux show-environment -t #{session_name} SSH_AUTH_SOCK 2>/dev/null)\" in *1password*) tmux set-environment -t #{session_name} -u SSH_AUTH_SOCK;; esac; tmux set-environment -t #{session_name} -u CLAUDECODE; tmux set-environment -t #{session_name} -u CODEX_HOME"'
set-hook -g client-attached 'run-shell "case \"$(tmux show-environment -t #{session_name} SSH_AUTH_SOCK 2>/dev/null)\" in *1password*) tmux set-environment -t #{session_name} -u SSH_AUTH_SOCK;; esac; tmux set-environment -t #{session_name} -u CLAUDECODE; tmux set-environment -t #{session_name} -u CODEX_HOME"'

set-option -g prefix C-q
bind-key C-q last-window
bind-key q send-prefix

setw -g aggressive-resize no

# set -g mouse on

# Pane border styling (Monokai Pro)
set -g pane-border-style 'fg=#403e41'
set -g pane-active-border-style 'fg=#a9dc76,bold'
set -g pane-border-lines heavy

set -g base-index 1
setw -g pane-base-index 1
unbind 0
bind 0 kill-pane

setw -g mode-keys vi
bind ` copy-mode
unbind [
unbind p
bind p paste-buffer
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi Escape send-keys -X cancel

unbind %
unbind c
bind c new-window -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind | split-window -h -c "#{pane_current_path}"

bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'

# Monokai Pro pills in native status formats; cpu and mem come from small scripts.
set -g status-style 'fg=#fcfcfa,bg=default'
set -g message-style 'fg=#fcfcfa,bg=default'
set -g status-interval 1
set -g status-justify centre
set -g status-left-length 60
set -g status-right-length 90
set -g status-left '#[fg=#78dce8,bg=default]#[fg=#2d2a2e,bg=#78dce8] #h #[fg=#78dce8,bg=#ab9df2]#[fg=#2d2a2e,bg=#ab9df2] #S #[fg=#ab9df2,bg=default]'
set -g status-right '#[fg=#403e41,bg=default]#[fg=#fc9867,bg=#403e41]#({{ .chezmoi.homeDir }}/.config/tmux-status/cpu.sh)#({{ .chezmoi.homeDir }}/.config/tmux-status/mem.sh)#[fg=#959394]%F %H:%M#[fg=#403e41,bg=default]'
set -g window-status-separator ' '
set -g window-status-current-format '#[fg=#a9dc76,bg=default]#[fg=#2d2a2e,bg=#a9dc76,bold]#I#[fg=#a9dc76,bg=#8ab866,nobold]#[fg=#2d2a2e,bg=#8ab866] #W#[fg=#8ab866,bg=default]'
set -g window-status-format '#[fg=#403e41,bg=default]#[fg=#959394,bg=#403e41]#I#[fg=#403e41,bg=#4a474b]#[fg=#959394,bg=#4a474b] #W#[fg=#4a474b,bg=default]'

if-shell '[ -f {{ .chezmoi.homeDir }}/.tmux/plugins/tpm/tpm ]' \
  'run "{{ .chezmoi.homeDir }}/.tmux/plugins/tpm/tpm"'

# Add empty line above the status bar for padding. Reset the array first, so
# a reload copies tmux's default row 0 again and not the '' left by the last load.
set -gu status-format
set -g status 2
set -gF status-format[1] '#{status-format[0]}'
set -g status-format[0] ''
