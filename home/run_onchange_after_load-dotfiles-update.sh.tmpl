{{- $isDevcontainer := or (env "REMOTE_CONTAINERS") (env "CODESPACES") -}}
{{- if not $isDevcontainer -}}
#!/bin/bash
# Load the hourly tbhb-dotfiles-update job, and reload it when its unit changes.
set -euo pipefail
{{- if eq .chezmoi.os "darwin" }}
# plist hash: {{ include "private_Library/LaunchAgents/dev.tbhb.dotfiles-update.plist.tmpl" | sha256sum }}
plist="{{ .chezmoi.homeDir }}/Library/LaunchAgents/dev.tbhb.dotfiles-update.plist"
domain="gui/$(id -u)"
job="${domain}/dev.tbhb.dotfiles-update"
# A plist launchd would reject must not unload the running job.
plutil -lint -s "${plist}"
if launchctl print "${job}" >/dev/null 2>&1; then
	# tbhb-dotfiles-update sets TBHB_DOTFILES_UPDATE. Booting out the job from
	# inside it would kill this apply, so the reload waits for a manual apply.
	if [[ -n "${TBHB_DOTFILES_UPDATE:-}" ]]; then
		echo "dev.tbhb.dotfiles-update changed; run chezmoi apply by hand to reload it" >&2
		exit 1
	fi
	launchctl bootout "${job}" || true
fi
# bootout returns before launchd has removed the job, and bootstrap fails
# until it has. A nonzero exit leaves this script pending for the next apply.
for _ in 1 2 3 4 5; do
	if launchctl bootstrap "${domain}" "${plist}"; then
		exit 0
	fi
	sleep 1
done
echo "could not load ${job}; run chezmoi apply again" >&2
exit 1
{{- else if eq .chezmoi.os "linux" }}
# unit hash: {{ include "private_dot_config/systemd/user/tbhb-dotfiles-update.service.tmpl" | sha256sum }} {{ include "private_dot_config/systemd/user/tbhb-dotfiles-update.timer.tmpl" | sha256sum }}
systemctl --user daemon-reload
systemctl --user enable --now tbhb-dotfiles-update.timer
{{- end }}
{{- end }}
