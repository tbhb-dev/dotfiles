#!/usr/bin/env python3
"""Set the Claude Code settings that dotfiles owns in ~/.claude/settings.json.

chezmoi runs this script with the live file on stdin and writes what it prints.
Dotfiles enforces three PreToolUse hooks on Bash, the Perl scripts in
~/.claude/hooks. It also supplies the base settings in
.chezmoitemplates/claude-settings-base.json, but only for a top-level key the
file lacks, so a host keeps its live values and a fresh host gets the full base.
The one exception is permissions.deny: base entries the live list lacks are
appended to it, so a new deny rule reaches a host that already has permissions.
Nothing is ever removed from the live deny list. A permissions that is not an
object, or a deny that is not a list, stops the script with a nonzero exit and
no output.
The one removal is permissions.allow: a host lists exact entries under
removeAllowEntries in its own chezmoi data, and the script drops those entries
from the live allow list. The names stay in the host's config, not in this repo.
With the key unset it removes nothing. A value that is not a list of strings
stops the script with a nonzero exit and no output.
Every other key and hook stays as it is, including the entries that
`tbhbdev alpha install` writes. A file that already has all of it prints back
unchanged, so chezmoi diff shows no change for it.
"""

import json
import sys

HOME = {{ .chezmoi.homeDir | quote }}
BASE = json.loads({{ includeTemplate "claude-settings-base.json" . | quote }})
REMOVE_ALLOW = json.loads({{ dig "removeAllowEntries" (list) . | toJson | quote }})
if not isinstance(REMOVE_ALLOW, list) or not all(isinstance(e, str) for e in REMOVE_ALLOW):
    sys.exit("modify_settings: removeAllowEntries is not a list of strings")
{{- if ne .chezmoi.os "darwin" }}
BASE.pop("statusLine", None)  # macOS-only command path
{{- end }}
OWNED = ("guard-exit-echo.pl", "rewrite-bsd-sed-i.pl", "rewrite-zsh-equals.pl")


def owned(name):
    return {
        "command": f"{HOME}/.claude/hooks/{name}",
        "timeout": 10,
        "type": "command",
    }


def basename(hook):
    return str(hook.get("command", "")).rsplit("/", 1)[-1]


def set_hooks(data):
    """Return True when it changed the hooks."""
    pre = data.setdefault("hooks", {}).setdefault("PreToolUse", [])
    entries = [e for e in pre if e.get("matcher") == "Bash"]
    ours = [e for e in entries if any(basename(h) in OWNED for h in e.get("hooks", []))]
    entry = ours[0] if ours else None
    if entry is None:
        entry = {"hooks": [], "matcher": "Bash"}
        pre.insert(0, entry)
    hooks = entry.setdefault("hooks", [])
    changed = False
    for name in OWNED:
        want = owned(name)
        found = [h for h in hooks if basename(h) == name]
        if found:
            if found[0] != want:
                found[0].clear()
                found[0].update(want)
                changed = True
        else:
            hooks.append(want)
            changed = True
    return changed


def set_base(data):
    """Return True when it added a base key or a base deny entry."""
    missing = [key for key in BASE if key not in data]
    for key in missing:
        data[key] = BASE[key]
    changed = bool(missing)
    if "permissions" not in missing:
        if not isinstance(data["permissions"], dict):
            sys.exit("modify_settings: permissions is not an object")
        if "deny" in data["permissions"] and not isinstance(data["permissions"]["deny"], list):
            sys.exit("modify_settings: permissions.deny is not a list")
        deny = data["permissions"].setdefault("deny", [])
        for entry in BASE.get("permissions", {}).get("deny", []):
            if entry not in deny:
                deny.append(entry)
                changed = True
    return changed


def drop_allow(data):
    """Return True when it removed an entry named in removeAllowEntries."""
    if not REMOVE_ALLOW:
        return False
    allow = data["permissions"].get("allow", [])
    if not isinstance(allow, list):
        sys.exit("modify_settings: permissions.allow is not a list")
    kept = [entry for entry in allow if entry not in REMOVE_ALLOW]
    if len(kept) == len(allow):
        return False
    data["permissions"]["allow"] = kept
    return True


text = sys.stdin.read()
data = json.loads(text) if text.strip() else {}
changed = set_base(data)
changed = drop_allow(data) or changed
if set_hooks(data) or changed:
    text = json.dumps(data, indent=2) + "\n"
sys.stdout.write(text)
