{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $isDevcontainer := or (env "REMOTE_CONTAINERS") (env "CODESPACES") -}}
{{- /* Opt-in per host: a prefix and short-name patterns from the chezmoi data, so no host names live in this public repo. */ -}}
{{- $sshShortPrefix := dig "sshShortHostPrefix" "" . -}}
{{- $sshShortPatterns := dig "sshShortHostPatterns" (list) . -}}
{{- /* Opt-in per host: the owner's account and the host patterns where agent sessions may not use it. */ -}}
{{- $sshRefuseUser := dig "sshAgentRefuseUser" "" . -}}
{{- /* Only plain names, since anything else could break every ssh or widen the match. Empty host entries are dropped. */ -}}
{{- if and $sshRefuseUser (not (regexMatch "^[A-Za-z0-9_][A-Za-z0-9._-]*$" $sshRefuseUser)) -}}{{ fail "sshAgentRefuseUser must be one plain account name" }}{{- end -}}
{{- $sshRefuseHosts := list -}}
{{- range (dig "sshAgentRefuseHosts" (list) .) -}}
{{- if and . (not (regexMatch "^[A-Za-z0-9_*?][A-Za-z0-9._*?-]*$" .)) -}}{{ fail "sshAgentRefuseHosts entries must be plain host names or patterns" }}{{- end -}}
{{- if . }}{{ $sshRefuseHosts = append $sshRefuseHosts . }}{{ end -}}
{{- end -}}

{{ if $isDarwin -}}
# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

{{ end -}}
{{ if not $isDevcontainer -}}
# Allowlist, same rule as .zprofile: the 1Password agent is used only when the
# terminal profile set TBHB_OP_AGENT=1 and no ssh or agent-harness variable is
# present. Everything else (a scrubbed env, a hook, a launchd job) gets keys on
# disk only, even if an inherited SSH_AUTH_SOCK is 1Password's.
Match exec "case $TBHB_OP_AGENT:$SSH_CONNECTION$CLAUDECODE$CODEX_HOME in 1:) exit 1;; esac"
  IdentityAgent none

{{ end -}}
{{ if and $sshShortPrefix $sshShortPatterns -}}
# Expand a bare short name to its full name, so ssh doesn't wait on a failing lookup of the short one.
Host {{ join " " $sshShortPatterns }}
  Hostname {{ $sshShortPrefix }}%h

{{ end -}}
{{ if and $isDarwin (not $isDevcontainer) -}}
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  IdentitiesOnly no

{{ else if and $isLinux (not $isDevcontainer) -}}
Host *
  IdentityAgent "~/.1password/agent.sock"
  IdentitiesOnly no

{{ end -}}
{{ if and $sshRefuseUser $sshRefuseHosts -}}
# The owner's account on these hosts is for the owner only. When an agent
# harness variable is set (CLAUDECODE, CODEX_HOME or CODEX_THREAD_ID), ssh
# stops itself while it reads this file. Without one,
# nothing changes. This deters mistakes; it is not a control. Killing the parent ssh from Match exec runs
# before any option takes effect, so -o, -i, -J and agent forwarding cannot skip
# it for a name that matches. The block sits at the end of the file, so every
# Hostname and User line before it counts. No final: that would add a second
# pass for every host. SIGKILL, since an inherited ignore can mask SIGTERM.
# user:* too, since sshd drops a :style suffix from the user name, and any
# user with a % token, which Match sees before expansion. /bin/sh -c reads the
# variables, so an unexported assignment in a startup file of SHELL doesn't
# count. An exported one still does.
Match host "{{ join "," $sshRefuseHosts }}" user "{{ $sshRefuseUser }},{{ $sshRefuseUser }}:*,*%*" exec "/bin/sh -c 'case ${CLAUDECODE-}${CODEX_HOME-}${CODEX_THREAD_ID-} in ?*) exit 0;; esac; exit 1' && { echo ssh refused: agent sessions may not log in as this user on this host. Use the ops account. >&2 || :; kill -9 $PPID; }"

{{ end -}}
