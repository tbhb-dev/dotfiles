{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $isDevcontainer := or (env "REMOTE_CONTAINERS") (env "CODESPACES") -}}
{{- /* Opt-in per host: a prefix and short-name patterns from the chezmoi data, so no host names live in this public repo. */ -}}
{{- $sshShortPrefix := dig "sshShortHostPrefix" "" . -}}
{{- $sshShortPatterns := dig "sshShortHostPatterns" (list) . -}}

{{ if $isDarwin -}}
# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

{{ end -}}
{{ if not $isDevcontainer -}}
# Same rule as .zprofile: over ssh or inside an agent harness, never use an
# agent (an inherited SSH_AUTH_SOCK may still be 1Password's); keys on disk only.
Match exec "case $SSH_CONNECTION$CLAUDECODE$CODEX_HOME in '') exit 1;; esac"
  IdentityAgent none

{{ end -}}
{{ if and $sshShortPrefix $sshShortPatterns -}}
# Expand a bare short name to its full name, so ssh doesn't wait on a failing lookup of the short one.
Host {{ join " " $sshShortPatterns }}
  Hostname {{ $sshShortPrefix }}%h

{{ end -}}
{{ if and $isDarwin (not $isDevcontainer) -}}
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  IdentitiesOnly no

{{ else if and $isLinux (not $isDevcontainer) -}}
Host *
  IdentityAgent "~/.1password/agent.sock"
  IdentitiesOnly no

{{ end -}}
