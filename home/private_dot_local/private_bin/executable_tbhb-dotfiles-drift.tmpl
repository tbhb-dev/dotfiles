{{- $isDevcontainer := or (env "REMOTE_CONTAINERS") (env "CODESPACES") -}}
{{- if not $isDevcontainer -}}
#!/bin/bash
# Report whether this host's dotfiles have drifted from origin/main. The
# launchd agent (macOS) or systemd user timer (Linux) runs it every hour.
#
# It only fetches and reads: it never merges, checks out or applies, and never
# runs a chezmoi run_ script. It prints one line per run,
#   drift=0|1 behind=N dirty=N branch=B status_lines=N src_sha=S origin_sha=O
# and exits 1 on drift. A failure prints `drift=1 error=<step>` and exits 2.
# No agent socket, prompt, askpass, credential helper or user ssh config
# reaches git or ssh. Bash 3.2 compatible (macOS /bin/bash).
set -euo pipefail

if [[ -n "${REMOTE_CONTAINERS:-}" || -n "${CODESPACES:-}" ]]; then
	exit 0
fi

unset SSH_AUTH_SOCK TBHB_OP_AGENT
export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false SSH_ASKPASS_REQUIRE=never
export GIT_SSH_COMMAND='ssh -F /dev/null -o BatchMode=yes -o IdentityAgent=none'
# An empty credential.helper clears every configured helper, for every git call.
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=credential.helper GIT_CONFIG_VALUE_0=

fail() {
	echo "drift=1 error=$1"
	exit 2
}

src="$(chezmoi source-path </dev/null)" || fail source_path
[[ -n "${src}" ]] || fail source_path
tree="$(git -C "${src}" rev-parse --show-toplevel)" || fail source_tree
branch="$(git -C "${tree}" symbolic-ref --quiet --short HEAD)" || branch=detached
dirty="$(git -C "${tree}" status --porcelain --untracked-files=all)" || fail git_status
git -C "${tree}" fetch --quiet origin main </dev/null || fail fetch
src_sha="$(git -C "${tree}" rev-parse HEAD)" || fail rev_parse
origin_sha="$(git -C "${tree}" rev-parse FETCH_HEAD)" || fail rev_parse
behind="$(git -C "${tree}" rev-list --count HEAD..FETCH_HEAD)" || fail rev_list
status="$(chezmoi status --no-tty </dev/null)" || fail chezmoi_status

count() {
	if [[ -z "$1" ]]; then
		echo 0
	else
		grep -c '' <<<"$1"
	fi
}
dirty_lines="$(count "${dirty}")"
status_lines="$(count "${status}")"
drift=0
if [[ "${behind}" != 0 || "${dirty_lines}" != 0 || "${branch}" != main || "${status_lines}" != 0 ]]; then
	drift=1
fi
echo "drift=${drift} behind=${behind} dirty=${dirty_lines} branch=${branch} status_lines=${status_lines} src_sha=${src_sha} origin_sha=${origin_sha}"
exit "${drift}"
{{- end }}
