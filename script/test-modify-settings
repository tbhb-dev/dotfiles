#!/usr/bin/env bash
# Tests for home/private_dot_claude/modify_settings.json.tmpl: renders the
# script with chezmoi, runs it on sample live files, and checks the deny merge.
# Needs chezmoi (CHEZMOI_BIN overrides the one on PATH) and python3. No network
# and no secret store.
set -euo pipefail

root="${TEST_SRCDIR:+${TEST_SRCDIR}/${TEST_WORKSPACE:-_main}}"
root="${root:-$(cd "$(dirname "$0")/.." && pwd)}"
work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT
: >"${work}/chezmoi.toml"

"${CHEZMOI_BIN:-chezmoi}" execute-template --config "${work}/chezmoi.toml" --source "${root}/home" <"${root}/home/private_dot_claude/modify_settings.json.tmpl" >"${work}/modify.py"

fails=0
rc=0
check() { # label; reads the status of the command just run from rc, then resets it
	if [[ ${rc} -eq 0 ]]; then echo "PASS  $1"; else
		echo "FAIL  $1"
		fails=$((fails + 1))
	fi
	rc=0
}

# check_json <json> <python snippet over d (the output) and base (the base deny list) that sets ok>
check_json() {
	python3 - "${work}/modify.py" "$1" "$2" <<'PY'
import json, sys
src = open(sys.argv[1]).read()
line = [l for l in src.splitlines() if l.startswith("BASE = ")][0]
base = eval(line[len("BASE = "):])["permissions"]["deny"]
d = json.loads(sys.argv[2])
ns = {"d": d, "base": base}
exec(sys.argv[3], ns)
sys.exit(0 if ns["ok"] else 1)
PY
}

# A host whose permissions exist: keeps its own entries, gains exactly the missing base ones.
live='{"hooks":{"Stop":[{"keep":1}]},"permissions":{"allow":["Bash(ls:*)"],"ask":["Bash(ask:*)"],"defaultMode":"plan","deny":["Bash(host only:*)","Bash(rm -rf /:*)"]},"model":"x"}'
out="$(python3 "${work}/modify.py" <<<"${live}")"
check_json "${out}" '
missing = [e for e in base if e != "Bash(rm -rf /:*)"]
dd = d["permissions"]["deny"]
ok = dd[:2] == ["Bash(host only:*)", "Bash(rm -rf /:*)"] and dd[2:] == missing
' || rc=$?
check "existing permissions gain exactly the missing base deny entries, in order, and lose none"
check_json "${out}" 'ok = d["permissions"]["allow"] == ["Bash(ls:*)"] and d["permissions"]["ask"] == ["Bash(ask:*)"] and d["permissions"]["defaultMode"] == "plan" and d["model"] == "x" and d["hooks"]["Stop"] == [{"keep": 1}]' || rc=$?
check "ask, allow, defaultMode, hooks and model are untouched"

# Idempotent: a second run changes nothing.
again="$(python3 "${work}/modify.py" <<<"${out}")"
[[ "${again}" == "${out}" ]] || rc=1
check "second run prints the file back unchanged"

# Permissions without a deny list gets the full base deny list.
out2="$(python3 "${work}/modify.py" <<<'{"permissions":{"allow":[]}}')"
check_json "${out2}" 'ok = d["permissions"]["deny"] == base' || rc=$?
check "permissions with no deny list gets the whole base list"

# Malformed permissions or deny: exit nonzero with empty stdout, never a silent pass.
all_rules="$(
	python3 - "${work}/modify.py" <<'PY'
import json, sys
src = open(sys.argv[1]).read()
line = [l for l in src.splitlines() if l.startswith("BASE = ")][0]
rules = eval(line[len("BASE = "):])["permissions"]["deny"]
print(json.dumps({"dict": {r: True for r in rules}, "string": " ".join(rules)}))
PY
)"
reject() { # label, live json
	local got
	rc=0
	got="$(python3 "${work}/modify.py" <<<"$2" 2>/dev/null)" || rc=$?
	[[ ${rc} -ne 0 && -z "${got}" ]] && rc=0 || rc=1
	check "$1"
}
dict_deny="$(python3 -c 'import json,sys; print(json.dumps({"permissions":{"deny":json.loads(sys.argv[1])["dict"]}}))' "${all_rules}")"
string_deny="$(python3 -c 'import json,sys; print(json.dumps({"permissions":{"deny":json.loads(sys.argv[1])["string"]}}))' "${all_rules}")"
reject "a deny dict keyed by every base rule is rejected" "${dict_deny}"
reject "a deny string holding every base rule is rejected" "${string_deny}"
reject "a null deny is rejected" '{"permissions":{"deny":null}}'
reject "a non-object permissions is rejected" '{"permissions":"deny everything"}'

# removeAllowEntries: drops exactly the named allow entries, keeps the rest in order,
# is idempotent, and with the key unset removes nothing (the runs above).
printf '[data]\nremoveAllowEntries = ["Bash(drop one:*)", "Bash(drop two:*)"]\n' >"${work}/remove.toml"
"${CHEZMOI_BIN:-chezmoi}" execute-template --config "${work}/remove.toml" --source "${root}/home" <"${root}/home/private_dot_claude/modify_settings.json.tmpl" >"${work}/modify-remove.py"
remove_live='{"permissions":{"allow":["Bash(keep a:*)","Bash(drop one:*)","Bash(keep b:*)","Bash(drop two:*)","Bash(drop one:*) extra"],"deny":[]}}'
rout="$(python3 "${work}/modify-remove.py" <<<"${remove_live}")"
check_json "${rout}" 'ok = d["permissions"]["allow"] == ["Bash(keep a:*)", "Bash(keep b:*)", "Bash(drop one:*) extra"]' || rc=$?
check "removeAllowEntries drops only the exact entries named and keeps the rest in order"
again_rm="$(python3 "${work}/modify-remove.py" <<<"${rout}")"
[[ "${again_rm}" == "${rout}" ]] || rc=1
check "a second run with removeAllowEntries prints the file back unchanged"
keep="$(python3 "${work}/modify.py" <<<"${remove_live}")"
check_json "${keep}" 'ok = len(d["permissions"]["allow"]) == 5' || rc=$?
check "with removeAllowEntries unset no allow entry is removed"
rc=0
python3 "${work}/modify-remove.py" <<<'{"permissions":{"allow":"x","deny":[]}}' >/dev/null 2>&1 || rc=$?
[[ ${rc} -ne 0 ]] && rc=0 || rc=1
check "a non-list allow with removeAllowEntries set exits nonzero"

exit "${fails}"
