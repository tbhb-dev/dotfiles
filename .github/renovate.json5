{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#2de8183920130fa8cc21d56ef5b331b0e0a15357", // main
    "github>tbhb-dev/renovate-config//bazel.json5#2de8183920130fa8cc21d56ef5b331b0e0a15357", // main
  ],

  // tbhb-dev/dotfiles: one Bazel module, no Go, so no go.json5.
  // Nothing local is needed beyond the presets.
}
