"""Bootstrap workspace for tbhb-dev/dotfiles."""

module(name = "tbhb_dev_dotfiles")

bazel_dep(name = "tbhb_rules", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "tbhb_rules",
    commit = "a05c4184255f2b55dc02bf2f046b78aa560c8505",
    remote = "https://github.com/tbhb-dev/rules.git",
)

# The tool binaries @tbhb_rules pins, so the bazel_env shims and CI name the
# same repositories and each tool keeps one pin.
tools = use_extension("@tbhb_rules//pins:extensions.bzl", "tools")
use_repo(
    tools,
    "tbhb_rules_actionlint",
    "tbhb_rules_cog",
    "tbhb_rules_editorconfig_checker",
    "tbhb_rules_rumdl",
    "tbhb_rules_ryl",
    "tbhb_rules_shellcheck",
    "tbhb_rules_shfmt",
    "tbhb_rules_tombi",
    "tbhb_rules_vale",
    "tbhb_rules_zizmor",
)

# Stable paths and PATH shims (.bazel_env/bin) for the Bazel-pinned tools,
# which git hooks and editors call without starting Bazel.
bazel_dep(name = "rules_shell", version = "0.6.1", dev_dependency = True)
bazel_dep(name = "platforms", version = "1.0.0", dev_dependency = True)
bazel_dep(name = "bazel_env.bzl", version = "0.10.0", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)

# The Vale style packages .vale.ini lists under Packages, pinned by digest so
# //:vale_test syncs them offline. Keep the URLs in step with .vale.ini.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "vale_google",
    dev_dependency = True,
    downloaded_file_path = "Google.zip",
    sha256 = "c1f61ae1c4cee3f2c2ffb2912fbbdff48a02c0e47e114dfd6435b15438171d97",
    url = "https://github.com/errata-ai/Google/releases/download/v0.7.2/Google.zip",
)

http_file(
    name = "vale_write_good",
    dev_dependency = True,
    downloaded_file_path = "write-good.zip",
    sha256 = "2960ef10861ddc7dc76292a4967eb3789bf05ca24f862042f6d15f53332887f0",
    url = "https://github.com/errata-ai/write-good/releases/download/v0.4.1/write-good.zip",
)

http_file(
    name = "vale_proselint",
    dev_dependency = True,
    downloaded_file_path = "proselint.zip",
    sha256 = "48b1fb481ba44f6505d44346b283f6cdc74efd234f913bbdb09bf34420fab81c",
    url = "https://github.com/errata-ai/proselint/releases/download/v0.3.4/proselint.zip",
)

http_file(
    name = "vale_ai_tells",
    dev_dependency = True,
    downloaded_file_path = "ai-tells.zip",
    sha256 = "f8d1e981abbfbac1aa092d1623a1ac9bc935f0b15e8071e7a072915abddf0570",
    url = "https://github.com/tbhb/vale-ai-tells/releases/download/v1.37.0/ai-tells.zip",
)

http_file(
    name = "vale_ai_tells_experimental",
    dev_dependency = True,
    downloaded_file_path = "ai-tells-experimental.zip",
    sha256 = "d628f719afead6812028c2a31802d87c7572a931d9b16e94f2874d95e9d597b8",
    url = "https://github.com/tbhb/vale-ai-tells/releases/download/v1.37.0/ai-tells-experimental.zip",
)

# chezmoi, pinned for the render test so CI and every host render with the
# same binary. The sha256 values come from the release's own checksums file.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_CHEZMOI_BUILD = """exports_files(["chezmoi"], visibility = ["//visibility:public"])"""

http_archive(
    name = "chezmoi_macos_arm64",
    build_file_content = _CHEZMOI_BUILD,
    sha256 = "fa14debabd557a9bb88a35c2950be6f5a8adf12e1c8cc26a9e0ee62fe0bdef2b",
    urls = ["https://github.com/twpayne/chezmoi/releases/download/v2.74.2/chezmoi_2.74.2_darwin_arm64.tar.gz"],
)

http_archive(
    name = "chezmoi_linux_x86_64",
    build_file_content = _CHEZMOI_BUILD,
    sha256 = "5f2024119a1860f18f2243b892dd43a79f0fefe2ebef9786ee143f4d5fd69ccb",
    urls = ["https://github.com/twpayne/chezmoi/releases/download/v2.74.2/chezmoi_2.74.2_linux_amd64.tar.gz"],
)

http_archive(
    name = "chezmoi_linux_arm64",
    build_file_content = _CHEZMOI_BUILD,
    sha256 = "bb1521dd02aff3967d61937213110e79ddd6e181e0856cf51e80dba01fda245f",
    urls = ["https://github.com/twpayne/chezmoi/releases/download/v2.74.2/chezmoi_2.74.2_linux_arm64.tar.gz"],
)
